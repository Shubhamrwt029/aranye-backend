# App
APP_NAME=Aranye API
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_DEBUG=true
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Explicit safety switch. Never enable this in production.
DEMO_DATA_ENABLED=true

# PostgreSQL — change password in production
# Homebrew Postgres (port 5433): postgresql+asyncpg://YOUR_MAC_USERNAME@localhost:5433/aranye_db
# Docker Postgres (port 5432):     postgresql+asyncpg://postgres:postgres@localhost:5432/aranye_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aranye_db

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Redis (for OTP storage)
REDIS_URL=redis://localhost:6379/0

# OTP provider: use console for debug_otp, or twilio for real SMS.
SMS_PROVIDER=console
# Twilio Verify uses the VA... service SID; it does not require a Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Prefer restricted API keys instead of the Auth Token in production:
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
TWILIO_TIMEOUT_SECONDS=10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
S3_BUCKET=aranye-media
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=http://localhost:9000/aranye-media
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_VIDEO_UPLOAD_BYTES=104857600
MEDIA_PRESIGN_EXPIRE_SECONDS=900
ENCRYPTION_KEY=
LAUNCH_CITY=
DEFAULT_DELIVERY_FEE_PAISE=0
SHOP_ACTIVATION_FEE_PAISE=49900

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
