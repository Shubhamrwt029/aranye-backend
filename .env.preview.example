APP_NAME=Aranye API (Preview)
ENVIRONMENT=preview
APP_DEBUG=false
PUBLIC_BASE_URL=https://api-preview.example.com
DEMO_DATA_ENABLED=true
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PREVIEW_DB_HOST:5432/aranye_preview
REDIS_URL=redis://PREVIEW_REDIS_HOST:6379/0
JWT_SECRET_KEY=replace-with-a-random-preview-secret-at-least-32-characters
SMS_PROVIDER=console
CORS_ORIGINS=["https://preview.example.com"]
