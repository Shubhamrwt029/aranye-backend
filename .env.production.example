APP_NAME=Aranye API
ENVIRONMENT=production
APP_DEBUG=false
PUBLIC_BASE_URL=https://api.example.com
DEMO_DATA_ENABLED=false
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PRODUCTION_DB_HOST:5432/aranye_production
REDIS_URL=redis://PRODUCTION_REDIS_HOST:6379/0
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
CORS_ORIGINS=["https://app.example.com"]
