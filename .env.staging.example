APP_NAME=Aranye API (Staging)
ENVIRONMENT=staging
APP_DEBUG=false
PUBLIC_BASE_URL=https://api-staging.example.com
DEMO_DATA_ENABLED=true
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@STAGING_DB_HOST:5432/aranye_staging
REDIS_URL=redis://STAGING_REDIS_HOST:6379/0
JWT_SECRET_KEY=replace-with-a-random-staging-secret-at-least-32-characters
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
CORS_ORIGINS=["https://staging.example.com"]
