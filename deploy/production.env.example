# Copy to /opt/aranye/backend/.env.production on the VPS and replace every CHANGE_ME value.
ARANYE_ENV_FILE=.env.production
API_BIND_PORT=8200
ARANYE_IMAGE_TAG=production

APP_NAME=Aranye API
ENVIRONMENT=production
APP_DEBUG=false
PUBLIC_BASE_URL=https://api.YOUR_DOMAIN
DEMO_DATA_ENABLED=false
API_DOCS_ENABLED=true
API_DOCS_USERNAME=aranye-docs
API_DOCS_PASSWORD=CHANGE_ME_DOCS_PASSWORD_AT_LEAST_16_CHARACTERS

POSTGRES_USER=aranye_production
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_DATABASE_PASSWORD
POSTGRES_DB=aranye_production
DATABASE_URL=postgresql+asyncpg://aranye_production:CHANGE_ME_PRODUCTION_DATABASE_PASSWORD@postgres:5432/aranye_production
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_PRODUCTION_JWT_SECRET_AT_LEAST_32_CHARACTERS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_VERIFY_SERVICE_SID=VA_CHANGE_ME
CORS_ORIGINS=["https://admin.YOUR_DOMAIN"]

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aranye-production-media
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_ENCRYPTION_KEY
