# Copy to /opt/aranye/backend/.env.staging on the VPS and replace every CHANGE_ME value.
ARANYE_ENV_FILE=.env.staging
API_BIND_PORT=8100

APP_NAME=Aranye API (Staging)
ENVIRONMENT=development
APP_DEBUG=true
PUBLIC_BASE_URL=http://VPS_IP/api/staging
DEMO_DATA_ENABLED=true

POSTGRES_USER=aranye_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DATABASE_PASSWORD
POSTGRES_DB=aranye_staging
DATABASE_URL=postgresql+asyncpg://aranye_staging:CHANGE_ME_STAGING_DATABASE_PASSWORD@postgres:5432/aranye_staging
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_SECRET_AT_LEAST_32_CHARACTERS
SMS_PROVIDER=console
CORS_ORIGINS=["http://VPS_IP"]

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aranye-staging-media
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENCRYPTION_KEY=
